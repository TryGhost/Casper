{{!< default}}

{{!-- The tag above means: insert everything in this file
into the {body} tag of the default.hbs template --}}


{{#post}}
{{!-- Everything inside the #post block pulls data from the page --}}

<main id="site-main" class="site-main">
<article class="article {{post_class}}">

    {{#match @page.show_title_and_feature_image}}
        <header class="article-header gh-canvas">

            <h1 class="article-title">{{title}}</h1>

            {{#if feature_image}}
                <figure class="article-image">
                    {{!-- This is a responsive image, it loads different sizes depending on device
                    https://medium.freecodecamp.org/a-guide-to-responsive-images-with-ready-to-use-templates-c400bd65c433 --}}
                    <img
                        srcset="{{img_url feature_image size="s"}} 300w,
                                {{img_url feature_image size="m"}} 600w,
                                {{img_url feature_image size="l"}} 1000w,
                                {{img_url feature_image size="xl"}} 2000w"
                        sizes="(min-width: 1400px) 1400px, 92vw"
                        src="{{img_url feature_image size="xl"}}"
                        alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                    />
                    {{#if feature_image_caption}}
                        <figcaption>{{feature_image_caption}}</figcaption>
                    {{/if}}
                </figure>
            {{/if}}

        </header>
    {{/match}}

    <section class="gh-content gh-canvas">
        {{content}}
    </section>

    <div class="inner posts">
        <section class="home-section" style="margin-bottom: 2rem;">
            <div id="ws-article-search"></div>
            <script data-cfasync="false" src="https://maps.wanderstories.space/ws-article-search.js?v=1.2.6"></script>
            <script data-cfasync="false">
            (function () {
                function initSearch() {
                    if (typeof wsArticleSearch !== 'function') return false;
                    if (!document.getElementById('ws-article-search')) return false;
                    wsArticleSearch({
                        container: '#ws-article-search',
                        baseUrl: 'https://maps.wanderstories.space',
                        pageSize: 12
                    });
                    return true;
                }
                function scheduleInit() {
                    if (initSearch()) return;
                    var tries = 0;
                    var timer = setInterval(function () {
                        if (initSearch() || ++tries > 50) clearInterval(timer);
                    }, 100);
                }
                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', scheduleInit);
                } else {
                    scheduleInit();
                }
            })();
            </script>
        </section>
        <div class="post-feed{{#match @custom.feed_layout "List"}} list{{/match}}">
            {{!-- Featured Posts --}}
            {{#get "posts" filter="featured:true" limit="all" include="tags"}}
                {{#foreach posts}}
                    {{> "post-card"}}
                {{/foreach}}
            {{/get}}
            {{!-- Australian Posts --}}
            {{#get "posts" filter="featured:false+tag:australia+tag:-story" limit="all" include="tags"}}
                {{#if posts}}
                    {{#foreach posts}}
                        {{> "post-card"}}
                    {{/foreach}}
                {{/if}}
            {{/get}}
            {{!-- Overseas Posts --}}
            {{#get "posts" filter="featured:false+tag:-australia+tag:-story" limit="all" include="tags"}}
                {{#if posts}}
                    {{#foreach posts}}
                        {{> "post-card"}}
                    {{/foreach}}
                {{/if}}
            {{/get}}
            {{!-- Story Posts --}}
            {{#get "posts" filter="featured:false+tag:story" limit="all" include="tags"}}
                {{#if posts}}
                    {{#foreach posts}}
                        {{> "post-card"}}
                    {{/foreach}}
                {{/if}}
            {{/get}}
        </div>
    </div>

</article>
</main>

{{/post}}
